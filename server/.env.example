# GoodBus API — copy to .env and fill in values

NODE_ENV=development
PORT=4000

# Local Docker Postgres (docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goodbus

# Production: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# Browser origin (Next.js URL)
CORS_ORIGIN=http://localhost:3000

# Kakao — https://developers.kakao.com
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_API_KEY=

# local | s3 (s3 not implemented yet — use local + disk backup on Lightsail)
STORAGE_PROVIDER=local

# Aligo phone-login OTP — https://smartsms.aligo.in
#
# All unset -> dev mode: OTP code is logged to the server console instead of
# being sent.
#
# Fill in the 3 below (API key + registered sender number) -> plain SMS.
# ALIGO_API_KEY=
# ALIGO_USER_ID=
# ALIGO_SENDER=
#
# Also fill in these 3 once the Kakao business channel + AlimTalk template
# are approved -> AlimTalk with automatic SMS failover (failover=Y) when the
# recipient can't receive AlimTalk. ALIGO_ALIMTALK_TEMPLATE must be the exact
# Kakao-approved template text, with the OTP code placeholder written as
# {{CODE}} (substituted at send time) — e.g.
#   [버스대절] 인증번호는 {{CODE}} 입니다. 5분 이내에 입력해주세요.
# ALIGO_KAKAO_SENDERKEY=
# ALIGO_ALIMTALK_TPL_CODE=
# ALIGO_ALIMTALK_TEMPLATE=

# Toss Payments — https://developers.tosspayments.com (무료 테스트 가입, 사업자등록 불필요)
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# Optional email (bid awarded, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Optional error tracking (production only — no DSN means Sentry stays disabled)
# SENTRY_DSN=https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# Optional: DB backup (scripts/backup-db.sh) — unset falls back to
# /var/backups/goodbus and 14-day retention.
# BACKUP_DIR=/var/backups/goodbus
# BACKUP_RETENTION_DAYS=14

# Optional bot-signup defense for /signup-business (Cloudflare Turnstile,
# free — unset means verifyTurnstileToken() always passes). Pair with the
# root .env.local's NEXT_PUBLIC_TURNSTILE_SITE_KEY.
# TURNSTILE_SECRET_KEY=
