// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Passenger
  Driver
  BusCompany
  Admin
}

enum UserStatus {
  Active
  Blocked
}

enum AdminRole {
  Super
  CustomerSupport
  Operations
  Finance
}

enum VerificationStatus {
  none
  pending
  approved
  rejected
}

enum BusSize {
  small
  medium
  large
}

enum TripStatus {
  open
  awarded
  cancelled
}

enum BidStatus {
  open
  withdrawn
  awarded
  lost
}

enum MembershipPlan {
  Basic
  Plus
  Premium
  Business
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
}

enum PaymentTransactionKind {
  membership_subscription
  min_bid_addon
  platform_commission
}

enum PaymentTransactionStatus {
  pending
  succeeded
  failed
  cancelled
}

enum SupportPostKind {
  notice
  faq
}

enum SupportInquiryCategory {
  quote_amount
  reservation_progress
  verification
  other
}

enum PhoneVerificationPurpose {
  signup
  login
}

enum PhoneAccountType {
  passenger
  business
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  passwordHash String?
  role        UserRole
  status      UserStatus @default(Active)
  adminRole   AdminRole?
  displayName String?
  companyName String?
  phoneNumber String?
  phoneVerifiedAt DateTime?
  garageAddress String?
  busNumber   String?
  busType     String?
  busYear     String?
  capacity    Int?
  driverComment String?
  profileImageUrl String?
  vehicleImageUrls String[] @default([])
  driverLicenseUrl String?
  driverLicenseStatus VerificationStatus @default(none)
  driverLicenseNote String?
  companyRegistrationUrl String?
  companyRegistrationStatus VerificationStatus @default(none)
  companyRegistrationNote String?
  membershipPlan MembershipPlan @default(Basic)
  minBidAddonPurchased Boolean @default(false)
  quoteAlertConsent Boolean @default(true)
  createdAt   DateTime @default(now())

  tripsAsPassenger Trip[] @relation("PassengerTrips")
  bids            Bid[]
  notifications   Notification[] @relation("UserNotifications")
  notificationHistories NotificationHistory[] @relation("UserNotificationHistories")
  chatRoomsAsPassenger ChatRoom[] @relation("PassengerChatRooms")
  chatRoomsAsBidder    ChatRoom[] @relation("BidderChatRooms")
  chatMessages         ChatMessage[] @relation("ChatMessageSender")
  supportPostsCreated  SupportPost[] @relation("SupportPostAuthor")
  supportInquiries     SupportInquiry[]
  reviewsWritten       TripReview[] @relation("PassengerReviews")
  reviewsReceived      TripReview[] @relation("DriverReviews")
  adminAuditLogs       AdminAuditLog[] @relation("AdminAuditActor")
  billingKey           BillingKey?
  membershipSubscription MembershipSubscription?
  minBidAddonSubscription MinBidAddonSubscription?
  paymentTransactions  PaymentTransaction[]

  // 같은 번호로 승객 계정 + 기사/회사 계정을 각각 만들 수 있게 role별로만 유일하게 잡음
  // (기사/회사는 같은 번호로 Driver·BusCompany 둘 다는 못 만듦 — auth.ts에서 그룹으로 막음).
  @@unique([phoneNumber, role])
}

model PhoneVerification {
  id          String                    @id @default(cuid())
  phoneNumber String
  purpose     PhoneVerificationPurpose
  accountType PhoneAccountType?
  codeHash    String
  attempts    Int                       @default(0)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime                  @default(now())

  @@index([phoneNumber, purpose, accountType, createdAt])
}

model SupportPost {
  id          String           @id @default(cuid())
  kind        SupportPostKind
  title       String
  body        String           @db.Text
  pinned      Boolean          @default(false)
  authorRole  AdminRole
  createdById String?
  createdBy   User?            @relation("SupportPostAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([kind, createdAt])
  @@index([kind, pinned, createdAt])
}

model SupportInquiry {
  id         String                  @id @default(cuid())
  userId     String
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   SupportInquiryCategory
  title      String
  body       String                  @db.Text
  adminReply String?                 @db.Text
  repliedAt  DateTime?
  createdAt  DateTime                @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Trip {
  id          String     @id @default(cuid())
  passengerId String
  passenger   User       @relation("PassengerTrips", fields: [passengerId], references: [id])
  origin      String
  originX     Float?
  originY     Float?
  destination String
  destinationX Float?
  destinationY Float?
  dateTime    DateTime
  paxCount    Int
  busSize     BusSize
  stopoverDetail String?
  companionType  String?
  itineraryDetail String?
  servicePurpose String?
  paymentMethod String?
  additionalRequest String?
  status      TripStatus @default(open)
  awardedAt   DateTime?
  cancelReason String?
  cancelledAt DateTime?
  createdAt   DateTime   @default(now())
  
  bids Bid[]
  chatRooms ChatRoom[]
  review TripReview?

  @@index([awardedAt])
  @@index([passengerId])
}

model TripReview {
  id          String   @id @default(cuid())
  tripId      String   @unique
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passengerId String
  passenger   User     @relation("PassengerReviews", fields: [passengerId], references: [id], onDelete: Cascade)
  driverId    String
  driver      User     @relation("DriverReviews", fields: [driverId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?  @db.Text
  imageUrls   String[] @default([])
  createdAt   DateTime @default(now())

  @@index([driverId, createdAt])
  @@index([passengerId])
}

model Bid {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User      @relation(fields: [bidderId], references: [id])
  price     Decimal
  note      String?
  status    BidStatus @default(open)
  createdAt DateTime  @default(now())
  
  @@index([tripId])
  @@index([bidderId])
}

model BillingKey {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tossBillingKey String   @unique
  customerKey    String   @unique
  cardBrand      String?
  cardLast4      String?
  createdAt      DateTime @default(now())
}

model MembershipSubscription {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          MembershipPlan
  pendingPlan   MembershipPlan?
  status        SubscriptionStatus @default(active)
  nextBillingAt DateTime
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, nextBillingAt])
}

model MinBidAddonSubscription {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        SubscriptionStatus @default(active)
  nextBillingAt DateTime
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, nextBillingAt])
}

model PaymentTransaction {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           PaymentTransactionKind
  status         PaymentTransactionStatus @default(pending)
  amount         Int
  tossOrderId    String                   @unique
  tossPaymentKey String?                  @unique
  tripId         String?
  bidId          String?
  failReason     String?
  metadata       Json?
  createdAt      DateTime                 @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

enum NotificationType {
  BID_RECEIVED
  BID_AWARDED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  AWARD_PAYMENT_FAILED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  tripId    String?
  bidId     String?
  createdAt DateTime         @default(now())
  
  @@index([userId])
  @@index([read])
}

model NotificationHistory {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation("UserNotificationHistories", fields: [userId], references: [id], onDelete: Cascade)
  type                  NotificationType
  title                 String
  message               String
  tripId                String?
  bidId                 String?
  notificationCreatedAt DateTime
  readAt                DateTime         @default(now())
  
  @@index([userId])
  @@index([readAt])
}

model ChatRoom {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passengerId String
  passenger   User     @relation("PassengerChatRooms", fields: [passengerId], references: [id], onDelete: Cascade)
  bidderId    String
  bidder      User     @relation("BidderChatRooms", fields: [bidderId], references: [id], onDelete: Cascade)
  passengerLeftAt DateTime?
  bidderLeftAt    DateTime?
  /// 승객 본인 목록·헤더 전용 표시 제목
  passengerPrivateTitle String?
  /// 입찰자(기사·업체) 본인 목록·헤더 전용 표시 제목
  bidderPrivateTitle    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages ChatMessage[]

  @@unique([tripId, bidderId])
  @@index([tripId])
  @@index([passengerId])
  @@index([bidderId])
}

model ChatMessage {
  id        String    @id @default(cuid())
  roomId    String
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([roomId])
  @@index([senderId])
  @@index([readAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AdminAuditActor", fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
