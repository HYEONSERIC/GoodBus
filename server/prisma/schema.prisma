// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Passenger
  Driver
  BusCompany
  Admin
}

enum UserStatus {
  Active
  Blocked
}

enum AdminRole {
  Super
  CustomerSupport
  Operations
  Finance
}

enum VerificationStatus {
  none
  pending
  approved
  rejected
}

enum BusSize {
  small
  medium
  large
}

enum TripStatus {
  open
  awarded
  cancelled
}

enum BidStatus {
  open
  withdrawn
  awarded
  lost
}

enum SupportPostKind {
  notice
  faq
}

enum SupportInquiryCategory {
  quote_amount
  reservation_progress
  verification
  other
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  passwordHash String
  role        UserRole
  status      UserStatus @default(Active)
  adminRole   AdminRole?
  displayName String?
  companyName String?
  phoneNumber String?
  garageAddress String?
  busNumber   String?
  busType     String?
  busYear     String?
  capacity    Int?
  driverComment String?
  profileImageUrl String?
  vehicleImageUrls String[] @default([])
  driverLicenseUrl String?
  driverLicenseStatus VerificationStatus @default(none)
  driverLicenseNote String?
  companyRegistrationUrl String?
  companyRegistrationStatus VerificationStatus @default(none)
  companyRegistrationNote String?
  createdAt   DateTime @default(now())
  
  tripsAsPassenger Trip[] @relation("PassengerTrips")
  bids            Bid[]
  notifications   Notification[] @relation("UserNotifications")
  notificationHistories NotificationHistory[] @relation("UserNotificationHistories")
  chatRoomsAsPassenger ChatRoom[] @relation("PassengerChatRooms")
  chatRoomsAsBidder    ChatRoom[] @relation("BidderChatRooms")
  chatMessages         ChatMessage[] @relation("ChatMessageSender")
  supportPostsCreated  SupportPost[] @relation("SupportPostAuthor")
  supportInquiries     SupportInquiry[]
}

model SupportPost {
  id          String           @id @default(cuid())
  kind        SupportPostKind
  title       String
  body        String           @db.Text
  pinned      Boolean          @default(false)
  authorRole  AdminRole
  createdById String?
  createdBy   User?            @relation("SupportPostAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([kind, createdAt])
  @@index([kind, pinned, createdAt])
}

model SupportInquiry {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  SupportInquiryCategory
  title     String
  body      String                  @db.Text
  createdAt DateTime                @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Trip {
  id          String     @id @default(cuid())
  passengerId String
  passenger   User       @relation("PassengerTrips", fields: [passengerId], references: [id])
  origin      String
  originX     Float?
  originY     Float?
  destination String
  destinationX Float?
  destinationY Float?
  dateTime    DateTime
  paxCount    Int
  busSize     BusSize
  stopoverDetail String?
  companionType  String?
  itineraryDetail String?
  servicePurpose String?
  paymentMethod String?
  additionalRequest String?
  status      TripStatus @default(open)
  createdAt   DateTime   @default(now())
  
  bids Bid[]
  chatRooms ChatRoom[]
}

model Bid {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User      @relation(fields: [bidderId], references: [id])
  price     Decimal
  note      String?
  status    BidStatus @default(open)
  createdAt DateTime  @default(now())
  
  @@index([tripId])
  @@index([bidderId])
}

enum NotificationType {
  BID_RECEIVED
  BID_AWARDED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  tripId    String?
  bidId     String?
  createdAt DateTime         @default(now())
  
  @@index([userId])
  @@index([read])
}

model NotificationHistory {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation("UserNotificationHistories", fields: [userId], references: [id], onDelete: Cascade)
  type                  NotificationType
  title                 String
  message               String
  tripId                String?
  bidId                 String?
  notificationCreatedAt DateTime
  readAt                DateTime         @default(now())
  
  @@index([userId])
  @@index([readAt])
}

model ChatRoom {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passengerId String
  passenger   User     @relation("PassengerChatRooms", fields: [passengerId], references: [id], onDelete: Cascade)
  bidderId    String
  bidder      User     @relation("BidderChatRooms", fields: [bidderId], references: [id], onDelete: Cascade)
  passengerLeftAt DateTime?
  bidderLeftAt    DateTime?
  /// 승객 본인 목록·헤더 전용 표시 제목
  passengerPrivateTitle String?
  /// 입찰자(기사·업체) 본인 목록·헤더 전용 표시 제목
  bidderPrivateTitle    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages ChatMessage[]

  @@unique([tripId, bidderId])
  @@index([tripId])
  @@index([passengerId])
  @@index([bidderId])
}

model ChatMessage {
  id        String    @id @default(cuid())
  roomId    String
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([roomId])
  @@index([senderId])
  @@index([readAt])
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./erd.svg" 
}
