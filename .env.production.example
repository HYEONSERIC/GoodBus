# GoodBus Next.js — copy to .env.local on the server (or .env.local for local prod test)

NODE_ENV=production

# Internal Express URL (Next.js /api proxy only — not exposed to browser)
API_URL=http://127.0.0.1:4000

# Public site URL — used for /uploads image links in the browser
NEXT_PUBLIC_API_URL=https://your-domain.com

# Kakao JavaScript key (maps / places in browser if used)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Toss Payments client key — https://developers.tosspayments.com
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# Optional error tracking (production only — no DSN means Sentry stays disabled)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# Optional — only needed if uploading source maps to Sentry during build
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

